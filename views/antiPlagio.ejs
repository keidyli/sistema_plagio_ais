<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comparación de Títulos</title>
    <link rel="stylesheet" href="/stylesheets/plagio.css">
    <link rel="stylesheet" href="/sweetalert2/sweetalert2.min.css">
    <script src="/sweetalert2/sweetalert2.all.min.js"></script>
</head>
<body>
    <div class="container">
        <h1>Comparación de Títulos</h1>
       
        <!-- Barra de búsqueda -->
        <form action="/busqueda" method="POST" class="search-form">
            <input type="text" name="titulo" placeholder="Ingrese el título del proyecto" required>
            <button type="submit">Buscar</button>
            <a href="/busqueda">Refrescar</a>
            <a href="/principal">Salir</a>
        </form>

        <!-- Título de búsqueda -->

        <% const tituloSeguro = typeof titulo !== 'undefined' ? titulo : ''; %>

        <% if (tituloSeguro.trim() !== '') { %>
          <% if (resultados && resultados.length > 0) { %>
            <p class="busqueda-info">
              Resultados de búsqueda para: <strong><%= tituloSeguro %></strong>
            </p>
          <% } else { %> 
            <p class="busqueda-info">
              No se encontraron resultados para: <strong><%= tituloSeguro %></strong>
            </p>
          <% } %>
        <% } %>
        

        <% if (tituloSeguro && titulo.trim() !== '' && resultados && resultados.length > 0) { %>
          <form action="/reporte-pdf" method="get" target="_blank" style="margin-top: 10px;">
              <input type="hidden" name="titulo" value="<%= titulo %>">
              <button type="submit" style="background-color: #dc3545; color: white; padding: 8px 12px; border: none; border-radius: 4px; cursor: pointer;">
                  📄 Descargar PDF
              </button>
          </form>
        <% } %>
        
        <!-- Resultados -->
        <% if (typeof resultados !== 'undefined') { %>
            <% if (resultados.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Título del proyecto</th>
                            <th>Nombre del estudiante</th>
                            <th>Cédula</th>
                            <th>Similitud</th>
                            <th>Interpretación</th> 
                        </tr>
                    </thead>
                    <tbody>
                        <% resultados.forEach((resultado, index) => { 
                            let clasificacion = "";
                            if (resultado.similitud >= 90) {
                              clasificacion = "✨ Casi idéntico";
                            } else if (resultado.similitud >= 80) {
                              clasificacion = "✅ Muy similar";
                            } else if (resultado.similitud >= 70) {
                              clasificacion = "⚠️ Similar parcial / coincidencia temática";
                            } else {
                              clasificacion = "❌ No similar";
                            }
                          %>
                            <tr>
                              <td><%= resultado.titulo %></td>
                              <td><%= resultado.estudiante %></td>
                              <td><%= resultado.cedula %></td>
                              <td class="<%= resultado.similitud >= 88 ? 'similitud-alta' : '' %>">
                                <%= resultado.similitud %>%
                              </td>
                              <td style="text-align:center;">
                                <button onclick="mostrarInterpretacion('<%= clasificacion %>')">➕</button>
                              </td>
                            </tr>
                          <% }) %>
                    </tbody>
                </table>
            <% } else { %>
            <% } %>
        <% } %>
    </div>

    <script>
        function mostrarInterpretacion(texto) {
          Swal.fire({
            title: 'Interpretación del resultado',
            text: texto,
            icon: 'info',
            confirmButtonText: 'Cerrar'
          });
        }
      </script>
      
</body>
</html>
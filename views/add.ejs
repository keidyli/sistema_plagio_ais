<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/add.css">
    <title>ADD_INFO</title>
</head>
<body>
    <header class="main-header">
        <h1>Registro de Nueva Informacion</h1>
        <nav>
            <ul>
                <li><a class="regresar" method="POST" href="/principal">Regresar</a></li>
            </ul>
        </nav>
    </header>
    <form id='formulario' action="/add" method="post" id="addForm">
    <div class="container" >
        <div class="container-form">
            <div class="content-input">
                <legend>Datos personales</legend>
            <label  for="cedula">Cedula:</label>
            <input type="type" id="cdi_estu" name="cdi_estu" required maxlength="15">
          
            <label  for="nombres">Nombre Completo:</label>
            <input type="type" id="name_estu" name="name_estu" required maxlength="100">
           
            <label for="title" >Titulo del Proyecto:</label>
            <input type="text" id="title_project" name="title_project" required>

            <label for="lineamiento">Linea de Investigacion:</label>
            <input type="type" id="lineamiento" name="lineamiento" required maxlength="100">

            <label for="periodo">Periodo:</label>
            <input type="type" id="periodo" name="periodo" required maxlength="10">

            <label for="name_tutor" >Nombre del Tutor:</label>
            <input type="type" id="name_tutor" name="name_tutor" required maxlength="100">
          
            <label for="contact_tutor">Contacto del Tutor:</label>
            <input type="type" id="contact_tutor" name="contact_tutor" required maxlength="100">

        </div>
        <div class="container-btn">
            <button href="/principal" type="submit" class="btn">Registrar</button>
        </div>
    </div>

</form>
</body>
</html>
